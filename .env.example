# Supported runtime profile. Use test only for injected/offline test resources.
APP_PROFILE=full
# Optional. Blank uses the OS local-app-data directory outside this repository.
RAG_DATA_DIR=
GEMINI_API_KEY=replace-with-your-server-side-key
ADMIN_TOKEN=replace-with-a-long-random-server-side-token
PUBLIC_BASE_URL=http://127.0.0.1:8000
TRUST_PROXY_HEADERS=false
QUERY_TIMEOUT_SECONDS=120
DEPENDENCY_TIMEOUT_SECONDS=30
QUERY_RATE_LIMIT_PER_MINUTE=60
